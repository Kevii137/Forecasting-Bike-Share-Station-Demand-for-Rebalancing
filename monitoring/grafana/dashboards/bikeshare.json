    {
      "id": 16,
      "type": "table",
      "title": "Firing alerts",
      "description": "Alerts Prometheus is firing now. Model alerts carry action=retrain (used in Milestone 6).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "action": 2
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "action": "Action"
            }
          }
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Service",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Requests per second by endpoint",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (endpoint) (rate(bikeshare_requests_total{endpoint!=\"/metrics\"}[1m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Latency, 95th percentile",
      "description": "A request for an uncached day computes its features first (15 to 35 s).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(bikeshare_request_seconds_bucket{endpoint!=\"/metrics\"}[5m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
